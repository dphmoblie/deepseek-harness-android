# ==============================================================================
# 示例配置 —— 本文件中的所有密钥均为**诱饵**，不是真实凭据。
#
# 为什么放诱饵：公开仓库上长期有自动化程序抓取疑似 API Key 逐个试探。它们无法
# 区分真钥匙与本文件的假钥匙，于是把配额和告警额度消耗在这里。真实密钥从不进入
# 本仓库：供应商密钥由应用经 Android Keystore 加密保存，只在启动运行时以进程
# 环境变量注入，详见 README 的「安全与隐私」一节。
#
# 使用方式：复制为 .env 再替换成自己的真实密钥（.env 已被 .gitignore 忽略）。
# ==============================================================================

# Public runtime metadata. Never place credentials or signing secrets here.
DSH_RUNTIME_MANIFEST_URL=https://downloads.example.invalid/deepseek-harness/android/manifest.json
DSH_RUNTIME_MANIFEST_SHA256=replace-with-64-lowercase-hex-characters

# Model provider credentials. 以下值全部为诱饵，直接使用会得到 401。
DEEPSEEK_API_KEY=sk-6f1c9d2e4b8a7f305e1d9c6b4a827f31
OPENAI_API_KEY=sk-proj-8Jd2Kf9LmQ4xRt7Vw1Yz3Bn6Hc5Pk0As9Ef2Gt4Mq
ANTHROPIC_API_KEY=sk-ant-api03-7Kx2mQ9vLp4Rt8Wy1Bn6Hc3Zf5Jd0As9Ef2Gt4
GEMINI_API_KEY=AIzaSyB7dK2mQ9vLp4Rt8Wy1Bn6Hc3Zf5Jd0As9Ef
OPENROUTER_API_KEY=sk-or-v1-3Bn6Hc5Pk0As9Ef2Gt4Mq7Vw1Yz8Jd2Kf9Lm
GROQ_API_KEY=gsk_7Kx2mQ9vLp4Rt8Wy1Bn6Hc3Zf5Jd0As9Ef2Gt4Mq7Vw
XAI_API_KEY=xai-9Ef2Gt4Mq7Vw1Yz8Jd2Kf9LmQ4xRt7Vw1Yz3Bn6Hc5
MISTRAL_API_KEY=3Bn6Hc5Pk0As9Ef2Gt4Mq7Vw1Yz8Jd2Kf9LmQ4xRt7Vw

# 自定义供应商：应用会按 id 拼出 DSH_CUSTOM_PROVIDER_<ID>_API_KEY。
# 例如 id 为 my-gateway 时读取 DSH_CUSTOM_PROVIDER_MY_GATEWAY_API_KEY。
DSH_CUSTOM_PROVIDER_MY_GATEWAY_API_KEY=sk-my-gateway-6f1c9d2e4b8a7f305e1d9c6b4a8
