# Example only. Supply real credentials in an ignored .env file or encrypted settings.
# Never commit .env or signing credentials.

DSH_RUNTIME_MANIFEST_URL=https://downloads.example.invalid/deepseek-harness/android/manifest.json
DSH_RUNTIME_MANIFEST_SHA256=replace-with-64-lowercase-hex-characters

DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_CREDENTIAL
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_CREDENTIAL
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_CREDENTIAL
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_CREDENTIAL
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_CREDENTIAL
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_CREDENTIAL
XAI_API_KEY=REPLACE_WITH_YOUR_XAI_CREDENTIAL
MISTRAL_API_KEY=REPLACE_WITH_YOUR_MISTRAL_CREDENTIAL

# Custom provider id my-gateway maps to this environment variable.
DSH_CUSTOM_PROVIDER_MY_GATEWAY_API_KEY=REPLACE_WITH_YOUR_CUSTOM_CREDENTIAL
