{
  "name": "deepseek-harness-mobile",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "Capacitor Android control surface for a local DeepSeek Harness Ubuntu runtime",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "android:sync": "pnpm run build && cap sync android",
    "android:open": "cap open android",
    "android:check": "pnpm run build && cap sync android && cd android && gradlew.bat lint testDebugUnitTest",
    "prepare:runner": "node scripts/prepare-runner.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-插件",
    "ai-agent",
    "agent",
    "llm",
    "android",
    "capacitor",
    "ubuntu",
    "proot",
    "shizuku",
    "mobile",
    "harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standtrain/deepseek-harness-for-android.git"
  },
  "homepage": "https://github.com/standtrain/deepseek-harness-for-android"
}
