<?xml version="1.0" encoding="utf-8"?>
<!-- 球面底色：与启动图标一致的深墨绿，配品牌薄荷绿符号。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/overlay_ball_pressed" />
            <stroke android:width="1dp" android:color="@color/overlay_ball_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/overlay_ball_background" />
            <stroke android:width="1dp" android:color="@color/overlay_ball_stroke" />
        </shape>
    </item>
</selector>
